{
  "datasource": {
    "mysql": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "",
      "database": "",
      "table_aliases": {
        "employee": ["员工", "雇员"],
        "sales_order": ["销售", "订单", "销售额"]
      }
    }
  },
  "nl2sql": {
    "top_k": 3,
    "candidate_limit": 5,
    "schema_cache_ttl": 300,
    "allow_tables": [],
    "embedding": {
      "enabled": true,
      "backend": "fastembed",
      "model": "BAAI/bge-small-zh-v1.5",
      "device": "cpu",
      "top_k": 5,
      "threshold": 0.55,
      "summary_batch": 30,
      "summary_enabled": true,
      "cache_file": "storage/table_summaries.json",
      "warmup_on_start": false
    }
  }
}
